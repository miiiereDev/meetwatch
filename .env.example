# Copy to .env and adjust. Every value has a working default for the simulator.

# Which MeetProvider to use: simulator | google | csv
PROVIDER=simulator

# API server
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# SQLite database file (relative to apps/api)
DB_PATH=data/meetwatch.sqlite3

# --- Simulator ---
# Time scale for simulated sessions (1 = real time, 20 = a 45 min session plays in ~2 min)
SIMULATOR_SPEED=20
# Number of fake students in the seeded roster (capped at the seed list size)
SIMULATOR_ROSTER_SIZE=25

# --- Domain defaults (applied to newly created sessions) ---
LATE_THRESHOLD_MINUTES=10
MIN_ATTENDANCE_PCT=75

# --- Google Meet provider ---
# Poll interval for the Google Meet REST API while a meeting is active
MEET_POLL_INTERVAL_MS=15000
# OAuth 2.0 credentials from Google Cloud (see docs/GOOGLE_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
